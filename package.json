{
  "name": "materio-mui-nextjs-admin-template",
  "version": "5.0.0",
  "license": "Commercial",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=4096 -r tsx/cjs server.ts",
    "dev:next": "node --max-old-space-size=4096 node_modules/next/dist/bin/next dev --turbopack",
    "build": "npm run build:icons && node --max-old-space-size=4096 node_modules/next/dist/bin/next build",
    "build:fast": "node --max-old-space-size=4096 node_modules/next/dist/bin/next build",
    "build:optimized": "node --max-old-space-size=4096 build-optimize.js",
    "start": "next start",
    "start:socket": "node --max-old-space-size=4096 -r tsx/cjs server.ts",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "build:icons": "node --max-old-space-size=4096 -r tsx/cjs src/assets/iconify-icons/bundle-icons-css.ts",
    "postinstall": "npm run build:icons",
    "migrate": "dotenv -e .env -- npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio",
    "update-meeting-status": "tsx src/scripts/updateMeetingStatus.ts",
    "test-meeting-status": "tsx src/scripts/testMeetingStatus.ts",
    "seed-meeting-reviews": "tsx temp-seeders/meeting-reviews.seed.ts",
    "db:seed": "tsx temp-seeders/seed-all.ts",
    "db:reset": "npx prisma migrate reset --force && npm run db:seed",
    "clean": "rm -rf .next && rm -rf node_modules/.cache"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@floating-ui/react": "0.27.2",
    "@mui/icons-material": "^6.5.0",
    "@mui/lab": "6.0.0-beta.19",
    "@mui/material": "^6.5.0",
    "@mui/material-nextjs": "6.2.1",
    "@neondatabase/serverless": "^1.0.1",
    "@prisma/client": "5.22.0",
    "@reduxjs/toolkit": "2.5.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "classnames": "2.5.1",
    "date-fns": "4.1.0",
    "date-fns-tz": "^3.2.0",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "next": "15.1.2",
    "next-auth": "^4.24.11",
    "react": "18.3.1",
    "react-colorful": "^5.6.1",
    "react-confetti": "^6.4.0",
    "react-dom": "18.3.1",
    "react-perfect-scrollbar": "1.5.8",
    "react-quill": "^2.0.0",
    "react-redux": "9.2.0",
    "react-use": "17.6.0",
    "react-youtube": "^10.1.0",
    "redux-persist": "^6.0.0",
    "server-only": "0.0.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "4.19.2",
    "valibot": "0.42.1"
  },
  "devDependencies": {
    "@iconify/json": "2.2.286",
    "@iconify/tools": "4.1.1",
    "@iconify/types": "2.0.0",
    "@iconify/utils": "2.2.1",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "autoprefixer": "10.4.20",
    "consola": "3.3.0",
    "dotenv-cli": "7.4.4",
    "eslint": "8.57.1",
    "eslint-config-next": "15.1.2",
    "eslint-config-prettier": "9.1.0",
    "eslint-import-resolver-typescript": "3.7.0",
    "eslint-plugin-import": "2.31.0",
    "globby": "14.0.2",
    "postcss": "8.4.49",
    "postcss-styled-syntax": "0.7.0",
    "prettier": "3.4.2",
    "prisma": "5.22.0",
    "stylelint": "16.12.0",
    "stylelint-use-logical-spec": "5.0.1",
    "stylis": "4.3.4",
    "stylis-plugin-rtl": "2.1.1",
    "tailwindcss": "3.4.17",
    "tailwindcss-logical": "3.0.1",
    "typescript": "5.5.4"
  },
  "resolutions": {
    "rimraf": "^5.0.7"
  },
  "overrides": {
    "rimraf": "^5.0.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed-south-korea-cities.ts"
  }
}
